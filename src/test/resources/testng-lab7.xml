<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Lab 7 - Reporting and Logging Test Suite">

    <!-- ============================================= -->
    <!-- LAB 7 SUITE: TestNG Listeners va Logging      -->
    <!-- ============================================= -->

    <!-- Test Listener se tu dong chay voi tat ca tests -->

    <!-- Test 1: Chay tat ca lab7 tests -->
    <test name="All Lab 7 Tests">
        <groups>
            <run>
                <include name="lab7"/>
            </run>
        </groups>
        <classes>
            <class name="com.example.shop.ui.Lab7ListenerTest"/>
            <class name="com.example.shop.ui.Lab7Logger"/>
        </classes>
    </test>

    <!-- Test 2: Chi chay smoke tests -->
    <test name="Smoke Tests Only">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="lab7"/>
            </run>
        </groups>
        <classes>
            <class name="com.example.shop.ui.Lab7ListenerTest"/>
            <class name="com.example.shop.ui.Lab7Logger"/>
        </classes>
    </test>

</suite>
